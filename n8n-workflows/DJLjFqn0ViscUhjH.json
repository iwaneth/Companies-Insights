      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst propertyCheck = inputData.properties.propertyCheck || {}; \nconst newValues = inputData.properties.newValues || {}; \nconst companyId = inputData.properties.id.ID; \n\nlet rawDate = inputData.properties.newValues?.founded;\nlet cleanDate = rawDate ? rawDate.replace(/^\\+/, '') : null\n  \nnewValues.founded = cleanDate;\n\nlet updatesToMake = {};\nlet hasChanges = false;\n\nfor (let key of Object.keys(propertyCheck)) {\n  if (propertyCheck[key] === true) {\n    let dbField = key.startsWith('c') ? key.substring(1) : key;\n    \n    updatesToMake[dbField] = newValues[dbField];\n    hasChanges = true;\n  }\n}\n\nif (hasChanges) {\n  updatesToMake.id = companyId; \n  updatesToMake.lastCompaniesUpdate = new Date().toISOString();\n  return [{ json: updatesToMake }];\n} else {\n  return []; \n}"
